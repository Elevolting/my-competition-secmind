# Optional: copy to .env.pi for start-runtime-dispatcher-pi.ps1 -Independent.
# The default Pi Dispatcher uses the platform model page instead.
# Set values from your chosen provider. PI_BASE_URL should include /v1 for
# OpenAI-compatible endpoints. Other APIs are supported by PI_PROVIDER_API.
PI_MODEL=replace-with-model-id
PI_BASE_URL=https://provider.example/v1
PI_API_KEY=replace-with-provider-key
PI_PROVIDER_API=openai-completions
PI_MODEL_CONTEXT_WINDOW=131072
