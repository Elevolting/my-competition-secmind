SECMIND_TOOL_ASSURANCE_HELDOUT_VERSION=
SECMIND_TOOL_ASSURANCE_HELDOUT_MANIFEST_DIGEST=
SECMIND_TOOL_ASSURANCE_HELDOUT_REPORT_DIGEST=
SECMIND_SANDBOX_SEMGREP_IMAGE=
SECMIND_SEMGREP_SAST_RULE_BUNDLE_DIGEST=
SECMIND_SANDBOX_GITLEAKS_IMAGE=
SECMIND_SANDBOX_SYFT_IMAGE=
SECMIND_SANDBOX_OSV_IMAGE=
SECMIND_DOCKER_SOCKET=
SECMIND_UNSAFE_DEVELOPMENT_TOOLS=false
SECMIND_OPERATOR_TOKEN=
SECMIND_MAX_STEPS=12
SECMIND_MAX_TOOL_CALLS=12
SECMIND_MAX_MODEL_CALLS=32
SECMIND_MAX_RUNTIME_SECONDS=600
SECMIND_MAX_UPLOAD_BYTES=52428800
SECMIND_MAX_UPLOAD_TOTAL_BYTES=524288000
SECMIND_UPLOAD_TTL_SECONDS=86400
SECMIND_MAX_EXTRACTED_BYTES=209715200
