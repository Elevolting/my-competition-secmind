SECMIND_ENV=development
# Extra trusted Host names and browser origins for an explicitly configured proxy.
# Loopback hosts are always accepted. Do not use '*' for trusted hosts.
SECMIND_ALLOWED_HOSTS=
SECMIND_ALLOWED_BROWSER_ORIGINS=
SECMIND_RUNTIME_ROLE=embedded
SECMIND_RUNTIME_PROFILE=local-full
SECMIND_DEMO_MODE=true
POSTGRES_PASSWORD=
SECMIND_DATABASE_URL=sqlite:///./data/secmind.db
SECMIND_CHECKPOINT_DATABASE_URL=
SECMIND_INPUT_ROOT=./data/inputs
SECMIND_RUN_ROOT=./data/runs
SECMIND_UPLOAD_ROOT=./data/uploads
SECMIND_ARTIFACT_ROOT=./data/artifacts
SECMIND_MODEL_MODE=offline
SECMIND_ALLOW_LIVE_MODELS=false
SECMIND_MAX_MODEL_TIER=5.4
SECMIND_TRUSTED_MODEL_BASE_URLS=https://dashscope.aliyuncs.com/compatible-mode/v1
SECMIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SECMIND_MODEL_BASE_URL_PROVIDER=auto
SECMIND_QWEN_API_KEY=
SECMIND_DEEPSEEK_API_KEY=
SECMIND_OPENAI_API_KEY=
SECMIND_PLANNER_MODEL=qwen-plus
SECMIND_WORKER_MODEL=qwen-turbo
SECMIND_FALLBACK_MODEL=qwen-turbo
SECMIND_EMBEDDING_MODEL=text-embedding-v3
SECMIND_MODEL_REASONING_EFFORT=high
SECMIND_MODEL_THINKING_ENABLED=true
SECMIND_MODEL_MAX_OUTPUT_TOKENS=16000
SECMIND_MODEL_TIMEOUT_SECONDS=180
SECMIND_MODEL_PRIMARY_SOFT_TIMEOUT_SECONDS=300
SECMIND_MODEL_TASK_HARD_TIMEOUT_SECONDS=540
SECMIND_MODEL_RECOVERY_RESERVE_SECONDS=120
SECMIND_MODEL_STREAM_MAX_SECONDS=360
SECMIND_MODEL_CONNECT_TIMEOUT_SECONDS=10
SECMIND_MODEL_POOL_TIMEOUT_SECONDS=10
SECMIND_MODEL_WRITE_TIMEOUT_SECONDS=30
SECMIND_MODEL_READ_IDLE_TIMEOUT_SECONDS=240
SECMIND_MODEL_MAX_ATTEMPTS=3
SECMIND_MODEL_PROVIDER_HOST_CONCURRENCY=2
SECMIND_MODEL_PROVIDER_GATE_DIRECTORY=
SECMIND_MODEL_PROVIDER_RECOVERY_BACKOFF_SECONDS=12
SECMIND_MODEL_STRUCTURED_REPAIR_ATTEMPTS=1
SECMIND_MODEL_PRIMARY_FALLBACK_ENABLED=true
SECMIND_MODEL_STRUCTURED_OUTPUT_MODE=auto
SECMIND_MODEL_FALLBACK_MAX_OUTPUT_TOKENS=12000
SECMIND_MODEL_FALLBACK_THINKING_ENABLED=false
SECMIND_MODEL_FALLBACK_REASONING_EFFORT=high
SECMIND_MODEL_MAX_RESPONSE_BYTES=8388608
SECMIND_MODEL_JSON_RECOVERY_MAX_CHARS=262144
SECMIND_MODEL_JSON_RECOVERY_MAX_DEPTH=64
SECMIND_SOURCE_TRIAGE_MODE=rank_and_signed_skill
SECMIND_BINARY_LOG_PARSERS_ENABLED=false
SECMIND_HYBRID_KNOWLEDGE_ENABLED=false
SECMIND_HYBRID_KNOWLEDGE_OFFLINE_FALLBACK_ENABLED=true
SECMIND_SEMGREP_CANDIDATE_RULES_ENABLED=false
SECMIND_KNOWLEDGE_QUERY_VECTORS_PATH=
SECMIND_KNOWLEDGE_VECTOR_CORPUS_DIGEST=
SECMIND_QDRANT_VECTOR_SIZE=1024
SECMIND_HYBRID_KNOWLEDGE_TIMEOUT_SECONDS=0.5
SECMIND_AUDIT_KERNEL_MODE=shadow
SECMIND_AUDIT_CRITIC_ENABLED=false
SECMIND_AUDIT_PROFILE=extended
SECMIND_PROMPT_MODE=fixed
SECMIND_PROMPT_CATALOG_PATH=
SECMIND_PROMPT_TOP_K=3
SECMIND_PROMPT_OPTIMIZER_ENABLED=false
SECMIND_PROMPT_ADAPTIVE_POLICY_APPROVED=false
SECMIND_PROMPT_REVIEWED_AUTHORITATIVE_ENABLED=false
SECMIND_PROMPT_OPTIMIZER_MAX_TIER=5.4
SECMIND_PROMPT_OPTIMIZER_MAX_OUTPUT_TOKENS=1024
SECMIND_PROMPT_OPTIMIZER_TIMEOUT_SECONDS=30
SECMIND_PROMPT_OPTIMIZER_MAX_REPAIRS=1
SECMIND_PROMPT_OPTIMIZER_TRIGGER_RATE_LIMIT=0.20
SECMIND_PROMPT_ARTIFACT_CACHE_ENABLED=true
SECMIND_AUDIT_PRIMARY_CONCURRENCY=3
SECMIND_AUDIT_CRITIC_CONCURRENCY=2
SECMIND_AUDIT_SHARD_SIZE=6
SECMIND_AUDIT_MINIMUM_DISPATCH_SECONDS=5
SECMIND_AUDIT_JAVA_FAST_PATH=true
SECMIND_SANDBOX_RUNNER_URL=
SECMIND_SANDBOX_TOKEN=
SECMIND_SANDBOX_CONTROL_TOKEN=
SECMIND_SANDBOX_BANDIT_IMAGE=
SECMIND_SANDBOX_STAGING_IMAGE=
SECMIND_SANDBOX_DEDICATED_ROOTLESS=false
SECMIND_TOOL_ASSURANCE_PRIVATE_KEY_FILE=
